{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misogi",
  "version": "0.1.0",
  "identifier": "dev.misogi.app",
  "build": {
    "beforeBuildCommand": "npm run build --prefix .. && node ../scripts/bundle-sidecar.mjs",
    "beforeDevCommand": "npm run build --prefix .. && node ../scripts/bundle-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Ce que Jev pense de chaque décision de ton agent",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../hooks/bundle/": "misogi/"
    },
    "linux": {
      "deb": { "depends": ["nodejs", "libayatana-appindicator3-1"] },
      "rpm": { "depends": ["nodejs", "libappindicator-gtk3"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
