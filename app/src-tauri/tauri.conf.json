{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misogi",
  "version": "0.2.2",
  "identifier": "dev.misogi.desktop",
  "build": {
    "beforeBuildCommand": "npm run build --prefix .. && node ../scripts/bundle-sidecar.mjs",
    "beforeDevCommand": "npm run build --prefix .. && node ../scripts/bundle-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Misogi",
    "homepage": "https://github.com/nadsous/Misogi",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Ce que Jev pense de chaque décision de ton agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../hooks/bundle/": "sidecar/"
    },
    "linux": {
      "deb": {
        "depends": [
          "nodejs",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "nodejs",
          "libappindicator-gtk3"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMDVFMzk4QUIzMTZBMTMKUldRVGFqR3JtT01Gd2ExSldqZmc1QmI0LzNiNHlHTWxRcncyQ0pvbCtVdmhmUTJmSmxYZEZFYXIK",
      "endpoints": [
        "https://github.com/nadsous/Misogi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
