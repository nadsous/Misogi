{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "La fenêtre charge l'interface servie par le serveur local : on n'autorise que cette origine.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:4317/*", "http://localhost:5173/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:allow-open"
  ]
}
